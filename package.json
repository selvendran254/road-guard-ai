{
  "name": "roadguard-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:dashboard": "npm run dev --workspace=@roadguard/dashboard",
    "dev:mobile": "npm run start --workspace=@roadguard/mobile",
    "build:server": "npm run build --workspace=server",
    "build:dashboard": "npm run build --workspace=@roadguard/dashboard",
    "install:all": "npm install"
  },
  "engines": {
    "node": ">=18"
  }
}
